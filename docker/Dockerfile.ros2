# syntax=docker/dockerfile:1
#
# GroundingDINO ROS 2 node, built from pixi.lock against RoboStack.
#
# This image used to be `FROM ros:humble-ros-base` with everything installed by
# pip and apt.  That was forced: apt's rclpy and cv_bridge are bound to the
# system interpreter, so no conda environment could be swapped in underneath
# them, so the detector had to be compiled here from a git clone --
# `apt-get install cuda-toolkit-11-8`, `TORCH_CUDA_ARCH_LIST`, `FORCE_CUDA=1`.
#
# RoboStack publishes ROS 2 Humble as conda packages, which removes the premise.
# The whole stack -- rclpy, cv_bridge, pytorch, and the detector -- now comes
# from one solve, recorded in pixi.lock as the `ros` environment.  What goes
# away with it:
#
#   * the CUDA toolkit apt install and the CUDA_HOME/LD_LIBRARY_PATH juggling;
#     conda-forge's pytorch brings its own CUDA runtime, and only the host
#     driver is needed (nvidia-container-toolkit)
#   * `git clone --branch integration/split-fixes` of a GroundingDINO fork and
#     the extension compile, replaced by groundingdino-py + groundingdino-py-cuda
#   * the pip install of `.[docker]`; the `ros` environment already has it
#   * the assertion that the installed groundingdino wins over ./groundingdino,
#     which is now structurally true: nothing is installed into a dist-packages
#     that the source tree could shadow
#
# One thing it costs: Python 3.12, not 3.10.  RoboStack has no 3.10 build of
# humble for linux-64, so the `ros` environment pins 3.12 while the default
# environment stays on 3.10.  See [tool.pixi.feature.ros] in pyproject.toml.
#
# Build with docker/build_ros2.sh -- it still stages trinity_msgs into the
# context, which is the one thing that cannot come from a channel.

ARG PIXI_VERSION=0.77.0
ARG UBUNTU_VERSION=24.04


# ── build: solve the ros environment and compile the workspace ───────────────
FROM ghcr.io/prefix-dev/pixi:${PIXI_VERSION}-noble AS build

# /app/GroundingDINO, not /app: the ROS parameter defaults, the compose mounts,
# check_perception_output.sh, QUICKSTART.md and DEMO.md all name this path.
# Moving it is a separate change from swapping the build out.
WORKDIR /app/GroundingDINO

# cython_bbox is an sdist and compiles a C extension on install.  Nothing else
# here needs a compiler -- the ROS packages and the detector arrive built.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml pixi.lock README.md LICENSE ./
COPY eval/ ./eval/
COPY tracker/ ./tracker/
COPY utils/ ./utils/
# No trailing slash: `helper` is a file, not a directory.
COPY helper ./helper

# The build host has no GPU, so the __cuda virtual package is absent and the
# solve would fail on the workspace's `cuda = "12.9"`.  This asserts what the
# deployment host provides; the container still needs a real driver at run time.
ARG CONDA_OVERRIDE_CUDA=12.9
ENV CONDA_OVERRIDE_CUDA=${CONDA_OVERRIDE_CUDA}

RUN pixi install --locked --environment ros

# GroundingDINO builds a bert-base-uncased text encoder, which transformers
# otherwise fetches from HuggingFace on every cold container -- inside the first
# callback's latency, and not at all on an air-gapped robot.
ENV HF_HOME=/opt/hf-cache
RUN pixi run --locked --environment ros python -c "\
from transformers import AutoTokenizer, BertModel; \
AutoTokenizer.from_pretrained('bert-base-uncased'); \
BertModel.from_pretrained('bert-base-uncased')"

# Activation for the `ros` environment.  This is what replaces
# `source /opt/ros/humble/setup.bash`: RoboStack ships ROS's environment as
# conda activation scripts, so activating the environment sets AMENT_PREFIX_PATH,
# ROS_DISTRO, RMW_IMPLEMENTATION and the rest.
RUN pixi shell-hook --locked --environment ros -s bash > /shell-hook.sh

COPY . /app/GroundingDINO

# ── the ROS workspace ────────────────────────────────────────────────────────
# trinity_msgs is staged into the build context by docker/build_ros2.sh, which
# pins the revision the running stack uses -- ROS 2 silently refuses to connect
# publishers and subscribers whose type definitions differ, so this must match
# rather than track HEAD.
COPY ros2_package/groundingdino_ros /app/ros2_ws/src/groundingdino_ros
COPY _trinity_msgs_build /app/ros2_ws/src/trinity_msgs

# colcon, ament and the rosidl generators come from the environment now, not
# from apt.  --symlink-install is dropped: it points the install tree back at
# /app/ros2_ws/src, and this stage's filesystem is not what ends up in the
# runtime image.
RUN bash -c 'set -euo pipefail; \
    source /shell-hook.sh; \
    cd /app/ros2_ws; \
    colcon build --packages-select trinity_msgs groundingdino_ros'


# ── runtime ──────────────────────────────────────────────────────────────────
FROM ubuntu:${UBUNTU_VERSION} AS runtime

# The pixi environment carries its own libGL, libEGL and glib, so the usual
# apt incantation for opencv is not needed.  ca-certificates only.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app
COPY --from=build /shell-hook.sh /shell-hook.sh
COPY --from=build /opt/hf-cache /opt/hf-cache

RUN chmod +x /app/GroundingDINO/docker/ros2_entrypoint.sh

ENV HF_HOME=/opt/hf-cache \
    PYTHONUNBUFFERED=1 \
    ROS2_WS=/app/ros2_ws \
    GROUNDINGDINO_PATH=/app/GroundingDINO \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# eval/ holds worker_simple and scene_graph, which the node imports directly.
# The project itself is an editable install in the environment, so only these
# paths have to be added by hand.  Same value the old image exported.
ENV PYTHONPATH=/app/GroundingDINO:/app/GroundingDINO/eval

# ROS_DOMAIN_ID is left unset so `docker run -e ROS_DOMAIN_ID=...` decides; the
# compose file sets it.

# For `docker exec <container> bash`, which gets no ENTRYPOINT.  The CUDA_HOME
# and LD_LIBRARY_PATH exports the old image wrote here are gone with the toolkit.
RUN printf '%s\n' \
    'source /shell-hook.sh' \
    'source /app/ros2_ws/install/setup.bash' \
    >> /root/.bashrc

WORKDIR /app/GroundingDINO
EXPOSE 7400-7500/udp

ENTRYPOINT ["/app/GroundingDINO/docker/ros2_entrypoint.sh"]
CMD ["ros2", "launch", "groundingdino_ros", "groundingdino.launch.py"]
