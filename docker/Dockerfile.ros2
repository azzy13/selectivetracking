# syntax=docker/dockerfile:1
#
# GroundingDINO ROS 2 image using the locked Pixi/RoboStack environment.
# The ROS environment uses Python 3.12; see the ros feature in pyproject.toml.
# Build with docker/build_ros2.sh so trinity_msgs is staged into the context.

ARG PIXI_VERSION=0.77.0
ARG UBUNTU_VERSION=24.04


# Build the Pixi environment and ROS workspace.
FROM ghcr.io/prefix-dev/pixi:${PIXI_VERSION}-noble AS build

# Keep the project at the path expected by ROS parameters and compose mounts.
WORKDIR /app/GroundingDINO

# build-essential is needed for cython_bbox; git is needed for the CLIP dependency.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml pixi.lock README.md LICENSE ./
COPY eval/ ./eval/
COPY tracker/ ./tracker/
COPY utils/ ./utils/
# No trailing slash: `helper` is a file, not a directory.
COPY helper ./helper

# Allow the CUDA environment to resolve on build hosts without a GPU.
ARG CONDA_OVERRIDE_CUDA=12.9
ENV CONDA_OVERRIDE_CUDA=${CONDA_OVERRIDE_CUDA}

RUN pixi install --locked --environment ros

# Cache the BERT model in the image and allow runtime lock files in the cache.
ENV HF_HOME=/opt/hf-cache
RUN pixi run --locked --environment ros python -c "\
from transformers import AutoTokenizer, BertModel; \
AutoTokenizer.from_pretrained('bert-base-uncased'); \
BertModel.from_pretrained('bert-base-uncased')" \
    && chmod -R a+rwX /opt/hf-cache

# Generate the activation script used by the runtime image.
RUN pixi shell-hook --locked --environment ros -s bash > /shell-hook.sh

COPY . /app/GroundingDINO

# Build the ROS workspace with the staged trinity_msgs definitions.
COPY ros2_package/groundingdino_ros /app/ros2_ws/src/groundingdino_ros
COPY _trinity_msgs_build /app/ros2_ws/src/trinity_msgs

# Disable nounset while sourcing RoboStack activation scripts.
# Tests are disabled because the runtime environment does not include ROS lint packages.
RUN bash -c 'set -euo pipefail; \
    set +u; source /shell-hook.sh; set -u; \
    cd /app/ros2_ws; \
    colcon build --packages-select trinity_msgs groundingdino_ros \
        --cmake-args -DBUILD_TESTING=OFF'

# Ensure ROS package files are readable and executable regardless of host modes.
RUN chmod -R a+rX /app/ros2_ws /app/GroundingDINO/docker /app/GroundingDINO/ros2_package


# Runtime image.
FROM ubuntu:${UBUNTU_VERSION} AS runtime

# Run as a non-root user so bind-mounted output has predictable ownership.
# USER_UID and USER_GID can be overridden at build time.
ARG USER_NAME=dino
ARG USER_UID=1000
ARG USER_GID=1000

# Native runtime libraries are provided by the Pixi environment.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 may already have a user with the requested UID.
RUN if getent passwd ${USER_UID} >/dev/null; then \
        userdel --remove "$(getent passwd ${USER_UID} | cut -d: -f1)"; \
    fi; \
    getent group ${USER_GID} >/dev/null || groupadd --gid ${USER_GID} ${USER_NAME}; \
    useradd --uid ${USER_UID} --gid ${USER_GID} --create-home \
            --shell /bin/bash ${USER_NAME}

# Set ownership while copying to avoid an additional chown layer.
COPY --from=build --chown=${USER_UID}:${USER_GID} /app /app
COPY --from=build /shell-hook.sh /shell-hook.sh
COPY --from=build --chown=${USER_UID}:${USER_GID} /opt/hf-cache /opt/hf-cache

RUN chmod +x /app/GroundingDINO/docker/ros2_entrypoint.sh

ENV HOME=/home/${USER_NAME}

# Use the baked Hugging Face cache and a per-user Torch cache.
ENV HF_HOME=/opt/hf-cache \
    TORCH_HOME=${HOME}/.cache/torch \
    PYTHONUNBUFFERED=1 \
    ROS2_WS=/app/ros2_ws \
    GROUNDINGDINO_PATH=/app/GroundingDINO \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Add project modules imported directly by the ROS node.
ENV PYTHONPATH=/app/GroundingDINO:/app/GroundingDINO/eval

# ROS_DOMAIN_ID is supplied by the runtime environment or compose configuration.

# Make the Pixi and ROS environments available to shells started with docker exec.
# profile.d also covers non-interactive login shells.
RUN printf '%s\n' \
      'source /shell-hook.sh' \
      'if [ -f /app/ros2_ws/install/setup.bash ]; then source /app/ros2_ws/install/setup.bash; fi' \
      > /etc/profile.d/ros2_env.sh && \
    chmod 0644 /etc/profile.d/ros2_env.sh && \
    echo '. /etc/profile.d/ros2_env.sh' >> /root/.bashrc && \
    echo '. /etc/profile.d/ros2_env.sh' >> ${HOME}/.bashrc

# Keep HOME and /output writable when the container is started with an arbitrary UID.
RUN mkdir -p ${HOME}/.ros/log ${TORCH_HOME} /output && \
    chmod -R 0777 ${HOME} /output

WORKDIR /app/GroundingDINO
EXPOSE 7400-7500/udp

# Run the application as the non-root container user.
USER ${USER_NAME}

ENTRYPOINT ["/app/GroundingDINO/docker/ros2_entrypoint.sh"]
CMD ["ros2", "launch", "groundingdino_ros", "groundingdino.launch.py"]
